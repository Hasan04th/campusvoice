<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CampusVoice – Report ragging, safety and housing problems</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4F6F8;--surface:#FFFFFF;--ink:#14213D;--muted:#566176;--line:#D9DEE6;
  --brand:#1F3A8A;--brand-ink:#FFFFFF;--accent:#1B8A7A;--alert:#C62F2F;--alert-bg:#FDECEC;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#0E1424;--surface:#161E33;--ink:#EAEFF9;--muted:#9AA6BF;--line:#26304A;--brand:#7C9BFF;--brand-ink:#0E1424;--accent:#4FD1BD;--alert:#FF7A7A;--alert-bg:#3A1A22}
}
:root[data-theme="dark"]{--bg:#0E1424;--surface:#161E33;--ink:#EAEFF9;--muted:#9AA6BF;--line:#26304A;--brand:#7C9BFF;--brand-ink:#0E1424;--accent:#4FD1BD;--alert:#FF7A7A;--alert-bg:#3A1A22}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.6 "Source Sans 3",system-ui,sans-serif}
h1,h2,h3{font-family:"Bricolage Grotesque",system-ui,sans-serif;line-height:1.1;margin:0;letter-spacing:-.02em}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.sr{position:absolute;left:-9999px}

/* emergency bar */
.sos{background:var(--alert-bg);color:var(--alert);font-weight:600;font-size:.95rem}
.sos .wrap{display:flex;gap:6px 16px;flex-wrap:wrap;align-items:center;padding-top:8px;padding-bottom:8px}
.sos a{font-weight:700;text-decoration:none;border-bottom:2px solid currentColor}

/* header */
header{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:env(safe-area-inset-top,0px);z-index:5}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font:800 1.35rem "Bricolage Grotesque",sans-serif;text-decoration:none;display:flex;align-items:center;gap:10px}
.logo i{width:28px;height:28px;border-radius:50% 50% 50% 4px;background:var(--brand);display:inline-block}
nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0;align-items:center}
nav a{text-decoration:none;font-weight:600;color:var(--muted)}
nav a:hover{color:var(--ink)}
.btn{display:inline-block;font:700 1rem "Source Sans 3",sans-serif;padding:13px 22px;border-radius:10px;border:2px solid var(--brand);background:var(--brand);color:var(--brand-ink);text-decoration:none;cursor:pointer}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn:hover{filter:brightness(1.08)}
.menu{display:none;background:none;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:8px 12px;font:600 1rem inherit;cursor:pointer}

/* hero */
.hero{padding:64px 0 40px;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.hero h1{font-size:clamp(2.4rem,5.4vw,3.9rem);font-weight:800}
.hero p.lead{font-size:1.2rem;color:var(--muted);max-width:34em;margin:20px 0 28px}
.hero .cta{display:flex;gap:12px;flex-wrap:wrap}
.hero small{display:block;margin-top:16px;color:var(--muted)}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:24px}
.panel h2{font-size:1.25rem;margin-bottom:4px}
.panel p{margin:0 0 16px;color:var(--muted);font-size:.98rem}
.cats{display:grid;gap:10px}
.cat{display:flex;align-items:center;gap:14px;text-align:left;width:100%;padding:14px 16px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font:600 1.02rem "Source Sans 3",sans-serif;cursor:pointer}
.cat:hover,.cat[aria-pressed="true"]{border-color:var(--brand);background:var(--surface);box-shadow:inset 4px 0 0 var(--brand)}
.cat span{display:block;font-weight:400;font-size:.9rem;color:var(--muted)}
.cat svg{flex:none;width:26px;height:26px;stroke:var(--brand);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.cat.fire svg{stroke:var(--alert)}
#pick{margin-top:14px;font-size:.95rem;min-height:1.4em;color:var(--accent);font-weight:600}

/* sections */
section{padding:56px 0}
section h2.t{font-size:clamp(1.7rem,3.4vw,2.4rem);max-width:20em}
section p.sub{color:var(--muted);max-width:36em;margin:12px 0 0}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px;counter-reset:s;padding:0;list-style:none}
.steps li{counter-increment:s;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px}
.steps li::before{content:counter(s);display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--brand);color:var(--brand-ink);font:700 1rem "Bricolage Grotesque",sans-serif;margin-bottom:12px}
.steps h3{font-size:1.2rem;margin-bottom:6px}
.steps p{margin:0;color:var(--muted)}
.band{background:var(--brand);color:var(--brand-ink)}
.band .wrap{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.band h2{font-size:clamp(1.7rem,3.2vw,2.3rem)}
.band ul{margin:0;padding:0;list-style:none;display:grid;gap:14px}
.band li{padding-left:30px;position:relative}
.band li::before{content:"";position:absolute;left:0;top:.45em;width:16px;height:9px;border-left:3px solid currentColor;border-bottom:3px solid currentColor;transform:rotate(-45deg)}
.track{display:flex;gap:10px;margin-top:22px;flex-wrap:wrap}
.track input{flex:1 1 240px;padding:13px 14px;border-radius:10px;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:1rem "Source Sans 3",sans-serif}
#tmsg{margin-top:12px;color:var(--muted);min-height:1.4em}
.contacts{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:28px}
.contacts div{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px}
.contacts b{display:block;font:700 1.9rem "Bricolage Grotesque",sans-serif;color:var(--alert)}
.contacts span{color:var(--muted);font-size:.95rem}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:.95rem}
footer .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}

@media (max-width:820px){
  .hero{grid-template-columns:1fr;padding-top:36px}
  .steps,.band .wrap{grid-template-columns:1fr}
  .menu{display:block}
  nav ul{display:none;position:absolute;left:0;right:0;top:64px;background:var(--surface);border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start;padding:16px 20px;gap:16px}
  nav ul.open{display:flex}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>

<div class="sos" role="region" aria-label="Emergency">
  <div class="wrap">
    <span>In danger right now, or a fire or serious injury? Don't use this form.</span>
    <span>Call national emergency <a href="tel:999">999</a> or campus security <a href="tel:+8800000000000" id="secTel">add campus number</a></span>
  </div>
</div>

<header>
  <div class="wrap nav">
    <a class="logo" href="#top"><i aria-hidden="true"></i>CampusVoice</a>
    <nav aria-label="Main">
      <button class="menu" id="menu" aria-expanded="false" aria-controls="links">Menu</button>
      <ul id="links">
        <li><a href="#report">Report</a></li>
        <li><a href="#how">How it works</a></li>
        <li><a href="#track">Track a report</a></li>
        <li><a href="#help">Emergency help</a></li>
           <li><a href="profile.html">My profile</a></li>
        <li><a class="btn ghost" href="login.html">Student log in</a></li>
        <li><a class="btn" href="report.html">Report a problem</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="top">
  <div class="wrap hero">
    <div>
      <h1>You don't have to put up with it alone.</h1>
      <p class="lead">Report ragging, unsafe housing, security threats, accidents or fire hazards on campus. Use your name or stay anonymous, then follow what happens next.</p>
      <div class="cta">
        <a class="btn" href="#report">Report a problem</a>
        <a class="btn ghost" href="#track">Check my report</a>
      </div>
      <small>Anonymous reports never ask for your name, email or phone number.</small>
    </div>

    <div class="panel" id="report">
      <h2>What happened?</h2>
      <p>Choose the closest match. You can add details on the next page.</p>
      <div class="cats" role="group" aria-label="Report category">
        <button class="cat" data-c="Ragging"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"/><path d="M12 8v5M12 16v.5"/></svg><div>Ragging or harassment<span>Bullying, threats, forced acts</span></div></button>
        <button class="cat" data-c="Accommodation"><svg viewBox="0 0 24 24"><path d="M3 11l9-7 9 7v9H3z"/><path d="M9 20v-6h6v6"/></svg><div>Hostel or accommodation<span>Repairs, food, water, overcrowding</span></div></button>
        <button class="cat" data-c="Security"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg><div>Security concern<span>Theft, stalking, unsafe areas</span></div></button>
        <button class="cat" data-c="Accident"><svg viewBox="0 0 24 24"><path d="M12 3l10 18H2z"/><path d="M12 10v5M12 18v.5"/></svg><div>Accident or injury<span>Falls, road or lab incidents</span></div></button>
        <button class="cat fire" data-c="Fire"><svg viewBox="0 0 24 24"><path d="M12 22c4 0 7-2.8 7-6.5 0-3-2-5-3.5-7-.5 1.5-1.5 2.5-2.5 2.5C13 8 12.5 5 10 2 9.5 6 5 8.5 5 15.5 5 19.2 8 22 12 22z"/></svg><div>Fire or electrical hazard<span>Faulty wiring, blocked exits, smoke</span></div></button>
      </div>
      <div id="pick" role="status" aria-live="polite"></div>
    </div>
  </div>

  <section id="how">
    <div class="wrap">
      <h2 class="t">From report to resolution in three steps</h2>
      <p class="sub">Every report is read by a named office, and every status change is recorded.</p>
      <ol class="steps">
        <li><h3>Tell us what happened</h3><p>Describe the incident, where it happened and how urgent it is. Add photos or video if you have them.</p></li>
        <li><h3>The right office responds</h3><p>Reports go to the proctor, hostel warden, security or fire safety officer. Serious cases are escalated.</p></li>
        <li><h3>Follow the progress</h3><p>See each update and reply to the team. Anonymous reporters use a tracking code.</p></li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Built so that reporting feels safe</h2>
      <ul>
        <li>Anonymous reports store no name, email or IP address.</li>
        <li>Only the staff assigned to your report can read it.</li>
        <li>Reports can't be deleted. Every action is logged.</li>
        <li>Works on a phone with a slow connection.</li>
      </ul>
    </div>
  </section>

  <section id="track">
    <div class="wrap">
      <h2 class="t">Already reported? Check the status</h2>
      <p class="sub">Enter the tracking code you received when you submitted.</p>
      <form class="track" id="trackForm" novalidate>
        <label class="sr" for="code">Tracking code</label>
        <input id="code" name="code" placeholder="e.g. CV-7K4M-92QX" autocomplete="off" maxlength="14">
        <button class="btn" type="submit">Check status</button>
      </form>
      <div id="tmsg" role="status" aria-live="polite"></div>
    </div>
  </section>

  <section id="help" style="padding-top:0">
    <div class="wrap">
      <h2 class="t">Need help right now?</h2>
      <p class="sub">Call first, then report here when you are safe. Replace the placeholders with your university's real numbers.</p>
      <div class="contacts">
        <div><b>999</b><span>National emergency: police, fire, ambulance</span></div>
        <div><b>Campus security</b><span>24-hour control room (add number)</span></div>
        <div><b>Proctor's office</b><span>Anti-ragging committee (add number)</span></div>
        <div><b>Health centre</b><span>Medical emergencies on campus (add number)</span></div>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <span>CampusVoice. Student safety reporting.</span>
    <span><a href="#">Privacy policy</a> &nbsp; <a href="#">Anti-ragging policy</a> &nbsp; <a href="#">Help</a></span>
  </div>
</footer>

<script>
(function(){
  var menu=document.getElementById('menu'),links=document.getElementById('links');
  menu.addEventListener('click',function(){
    var o=links.classList.toggle('open');menu.setAttribute('aria-expanded',o);
  });
  links.addEventListener('click',function(e){if(e.target.tagName==='A'){links.classList.remove('open');menu.setAttribute('aria-expanded','false');}});

  // Step 2 will point this to login.html
  document.getElementById('loginLink').addEventListener('click',function(e){e.preventDefault();alert('The student log in page is built in the next step.');});

  var cats=document.querySelectorAll('.cat'),pick=document.getElementById('pick');
  cats.forEach(function(b){
    b.addEventListener('click',function(){
      cats.forEach(function(x){x.setAttribute('aria-pressed','false')});
      b.setAttribute('aria-pressed','true');
      // Step 2 will send the student to report.html?category=...
      pick.textContent=b.dataset.c+' selected. The report form is built in the next step.';
    });
  });

  document.getElementById('trackForm').addEventListener('submit',function(e){
    e.preventDefault();
    var v=document.getElementById('code').value.trim().toUpperCase(),m=document.getElementById('tmsg');
    if(!/^CV-[A-Z0-9]{4}-[A-Z0-9]{4}$/.test(v)){m.textContent='Enter a code in the format CV-XXXX-XXXX.';return;}
    m.textContent='Status lookup will work once the database is connected (Step 3).';
  });
})();
</script>
</body>
</html>
